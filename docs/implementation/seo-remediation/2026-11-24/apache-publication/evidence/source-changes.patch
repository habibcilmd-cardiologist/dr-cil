diff --git a/layouts/partials/seo/social-image.html b/layouts/partials/seo/social-image.html
new file mode 100644
index 0000000..904a42c
--- /dev/null
+++ b/layouts/partials/seo/social-image.html
@@ -0,0 +1,32 @@
+{{/* Social cards require a raster image. SVG content diagrams remain in the
+     article and its semantic markup; use the existing site fallback for cards. */}}
+{{- $page := . -}}
+{{- $image := false -}}
+{{- $isFallback := false -}}
+{{- $rasterTypes := slice "image/jpeg" "image/png" "image/webp" "image/gif" -}}
+{{- range slice "*featured*" "*cover*" "*thumbnail*" -}}
+  {{- if not $image -}}
+    {{- range $page.Resources.Match . -}}
+      {{- if and (not $image) (in $rasterTypes .MediaType.Type) -}}{{- $image = . -}}{{- end -}}
+    {{- end -}}
+  {{- end -}}
+{{- end -}}
+{{- if not $image -}}
+  {{- with $page.Site.Params.defaultSocialImage -}}
+    {{- with resources.Get . -}}
+      {{- if in $rasterTypes .MediaType.Type -}}{{- $image = . -}}{{- $isFallback = true -}}{{- end -}}
+    {{- end -}}
+  {{- end -}}
+{{- end -}}
+{{- $result := dict -}}
+{{- with $image -}}
+  {{- $alt := $page.Title | plainify -}}
+  {{- if $isFallback -}}
+    {{- $alts := dict "tr" "Doç. Dr. Habib ÇİL — Kardiyoloji Uzmanı" "en" "Assoc. Prof. Dr. Habib ÇİL — Cardiologist" "ar" "د. حبيب جيل — أخصائي أمراض القلب" -}}
+    {{- $alt = index $alts $page.Language.Lang -}}
+  {{- end -}}
+  {{- $card := "summary" -}}
+  {{- if ge (div (float .Width) (float .Height)) 1.5 -}}{{- $card = "summary_large_image" -}}{{- end -}}
+  {{- $result = dict "image" . "fallback" $isFallback "alt" $alt "card" $card -}}
+{{- end -}}
+{{- return $result -}}
diff --git a/scripts/tests/analytics-guard.test.mjs b/scripts/tests/analytics-guard.test.mjs
new file mode 100644
index 0000000..920caf9
--- /dev/null
+++ b/scripts/tests/analytics-guard.test.mjs
@@ -0,0 +1,47 @@
+// Execute the actual compiled inline tag in a mock document; never sends HTTP.
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import vm from 'node:vm';
+
+const htmlFile = process.argv[2];
+if (!htmlFile) throw new Error('Pass the newly built public/index.html');
+const html = fs.readFileSync(htmlFile, 'utf8');
+const match = html.match(/<script\b(?=[^>]*\bid\s*=\s*["']?site-analytics(?:["'\s>]))[^>]*>([\s\S]*?)<\/script>/i);
+assert.ok(match, 'compiled production inline tag exists');
+const cases = [
+  ['http:', 'localhost', false],
+  ['https:', 'localhost', false],
+  ['http:', '127.0.0.1', false],
+  ['https:', '[::1]', false],
+  ['https:', 'preview.localhost', false],
+  ['https:', 'preview.example.invalid', false],
+  ['https:', 'docdrhabibcil.com.attacker.invalid', false],
+  ['http:', 'docdrhabibcil.com', false],
+  ['https:', 'docdrhabibcil.com', true],
+  ['https:', 'www.docdrhabibcil.com', true],
+];
+const reports = [];
+for (const [protocol, hostname, enabled] of cases) {
+  const appended = [];
+  const sandbox = {
+    location: {protocol, hostname},
+    document: {
+      createElement(tag) {assert.equal(tag, 'script'); return {};},
+      head: {appendChild(script) {appended.push(script);}},
+    },
+  };
+  sandbox.window = sandbox;
+  vm.runInNewContext(match[1], sandbox, {timeout:1000});
+  assert.equal(appended.length, enabled ? 1 : 0, `${protocol}//${hostname}: loader count`);
+  if (enabled) {
+    assert.equal(appended[0].src, 'https://www.googletagmanager.com/gtag/js?id=G-TDC4PMVEMK');
+    assert.equal(appended[0].async, true);
+    assert.equal(sandbox.dataLayer.length, 2);
+    assert.equal(sandbox.dataLayer[1][0], 'config');
+    assert.equal(sandbox.dataLayer[1][1], 'G-TDC4PMVEMK');
+  } else {
+    assert.equal(sandbox.dataLayer, undefined, 'preview has no measurement queue');
+  }
+  reports.push({protocol,hostname,enabled,pass:true});
+}
+console.log(JSON.stringify({scope:'Actual compiled inline script, VM/mock document only; no requests or real analytics events',htmlFile,passed:reports.length,cases:reports},null,2));
