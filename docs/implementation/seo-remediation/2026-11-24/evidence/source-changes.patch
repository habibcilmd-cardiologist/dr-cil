diff --git a/layouts/partials/seo/list-paginator.html b/layouts/partials/seo/list-paginator.html
new file mode 100644
index 0000000..d500778
--- /dev/null
+++ b/layouts/partials/seo/list-paginator.html
@@ -0,0 +1,13 @@
+{{- /* Match Blowfish list.html's collection and ordering before head metadata.
+  Never call Page.Paginator here: its default collection would win Hugo's
+  pagination cache before the list template can choose its actual collection. */ -}}
+{{- $pager := false -}}
+{{- if and (in (slice "section" "term") .Kind) (gt (len .Pages) 0) (ne .Layout "simple") -}}
+  {{- $orderByWeight := .Params.orderByWeight | default (.Site.Params.list.orderByWeight | default false) -}}
+  {{- if $orderByWeight -}}
+    {{- $pager = .Paginate .Pages.ByWeight -}}
+  {{- else -}}
+    {{- $pager = .Paginate (.Pages.GroupByDate "2006") -}}
+  {{- end -}}
+{{- end -}}
+{{- return $pager -}}
