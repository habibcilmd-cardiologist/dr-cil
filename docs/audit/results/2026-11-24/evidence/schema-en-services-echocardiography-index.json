      "value": {
        "@id": "https://docdrhabibcil.com/en/services/echocardiography/#faq",
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No, transthoracic echocardiography is a completely painless procedure. Only gel is applied to the chest and imaging is done with a probe."
            },
            "name": "Is echocardiography painful?"
          },
          {
            "@type": "Question",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Standard transthoracic echocardiography takes 20-45 minutes."
            },
            "name": "How long does echocardiography take?"
          },
          {
            "@type": "Question",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Fasting is not required for transthoracic echo. 6 hours fasting is required for transesophageal echo."
            },
            "name": "Do I need to fast for echocardiography?"
          },
          {
            "@type": "Question",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No, since ultrasound waves are used, it contains no radiation and is completely safe."
            },
            "name": "Is echocardiography harmful?"
          },
          {
            "@type": "Question",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Results are usually evaluated and reported on the same day."
            },
            "name": "When do echocardiography results come out?"
          }
        ],
        "name": "Echocardiography - Heart Ultrasound Imaging - Frequently Asked Questions",
