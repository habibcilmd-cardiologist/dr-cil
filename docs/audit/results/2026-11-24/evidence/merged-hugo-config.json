{
  "archetypedir": "archetypes",
  "assetdir": "assets",
  "author": {},
  "baseurl": "https://docdrhabibcil.com/",
  "build": {
    "cachebusters": [
      {
        "source": "(postcss|tailwind)\\.config\\.(js|mjs|cjs)",
        "target": "(css|styles|scss|sass)"
      }
    ],
    "cleandestinationdir": {
      "keepdirs": [
        "{**/,}.*"
      ],
      "keepfiles": [
        "{**/,}.{git,gitignore,gitattributes}"
      ]
    },
    "useresourcecachewhen": "fallback"
  },
  "cachedir": "/Users/yavuz/Library/Caches/hugo_cache",
  "caches": {
    "assets": {
      "dir": ":resourceDir/_gen",
      "maxage": -1
    },
    "getresource": {
      "dir": ":cacheDir/:project",
      "maxage": -1
    },
    "images": {
      "dir": ":resourceDir/_gen",
      "maxage": -1
    },
    "misc": {
      "dir": ":cacheDir/:project",
      "maxage": -1
    },
    "modulegitinfo": {
      "dir": ":cacheDir/modules",
      "maxage": "24h"
    },
    "modulequeries": {
      "dir": ":cacheDir/modules",
      "maxage": "24h"
    },
    "modules": {
      "dir": ":cacheDir/modules",
      "maxage": -1
    }
  },
  "capitalizelisttitles": true,
  "contentdir": "content/tr",
  "contenttypes": {
    "text/asciidoc": {},
    "text/html": {},
    "text/markdown": {},
    "text/org": {},
    "text/pandoc": {},
    "text/rst": {}
  },
  "datadir": "data",
  "defaultcontentlanguage": "tr",
  "defaultcontentrole": "guest",
  "defaultoutputformat": "html",
  "deployment": {
    "invalidatecdn": true,
    "maxdeletes": 256,
    "workers": 10
  },
  "environment": "production",
  "frontmatter": {
    "date": [
      "date",
      "publishdate",
      "pubdate",
      "published",
      "lastmod",
      "modified"
    ],
    "expirydate": [
      "expirydate",
      "unpublishdate"
    ],
    "lastmod": [
      ":git",
      "lastmod",
      "modified",
      "date",
      "publishdate",
      "pubdate",
      "published"
    ],
    "publishdate": [
      "publishdate",
      "pubdate",
      "published",
      "date"
    ]
  },
  "httpcache": {
    "cache": {
      "for": {
        "excludes": [
          "**"
        ]
      }
    },
    "polls": [
      {
        "disable": true,
        "for": {
          "includes": [
            "**"
          ]
        },
        "high": "0s",
        "low": "0s"
      }
    ],
    "respectcachecontrolnostoreinrequest": true
  },
  "i18ndir": "i18n",
  "imaging": {
    "anchor": "smart",
    "avif": {
      "compression": "lossy",
      "encoderspeed": 10,
      "hint": "photo",
      "quality": 85
    },
    "bgcolor": "ffffff",
    "exif": {
      "disablelatlong": true,
      "excludefields": "GPS|Exif|Exposure[M|P|B]|Contrast|Resolution|Sharp|JPEG|Metering|Sensing|Saturation|ColorSpace|Flash|WhiteBalance"
    },
    "jpeg": {
      "quality": 85
    },
    "meta": {
      "fields": [
        "! *{GPS,Exif,Exposure[MPB],Contrast,Resolution,Sharp,JPEG,Metering,Sensing,Saturation,ColorSpace,Flash,WhiteBalance}*"
      ],
      "sources": [
        "exif",
        "iptc"
      ]
    },
    "resamplefilter": "catmullrom",
    "webp": {
      "compression": "lossy",
      "hint": "photo",
      "method": 2,
      "quality": 85
    }
  },
  "languages": {
    "ar": {
      "label": "العربية",
      "locale": "ar-SA",
      "title": "أ.د. حبيب جيل | أخصائي أمراض القلب",
      "weight": 3
    },
    "en": {
      "label": "English",
      "locale": "en-US",
