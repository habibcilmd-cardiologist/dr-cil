# dr-cil compiled Hugo publication — Apache 2.4+, document-root deployment.
# Source mirror: /.htaccess. Publish the compiled public/ contents, including this file.
# Required: mod_rewrite, mod_dir, mod_authz_core and permitted .htaccess overrides.
# HTTPS: configure the host/CDN to enforce HTTPS using its trusted TLS topology.
# Do not trust arbitrary X-Forwarded-Proto headers or enable a proxy redirect loop.

Options -Indexes -MultiViews
DirectoryIndex index.html
DirectorySlash On
AddDefaultCharset UTF-8
FileETag MTime Size

# Local ErrorDocument preserves HTTP 404; no SPA/home-page fallback.
ErrorDocument 404 /404.html
<If "%{REQUEST_URI} =~ m#^/en(?:/|$)#">
    ErrorDocument 404 /en/404.html
</If>
<If "%{REQUEST_URI} =~ m#^/ar(?:/|$)#">
    ErrorDocument 404 /ar/404.html
</If>

RewriteEngine On

# Prevent publishing hidden/source-control files; retain ACME /.well-known/ paths.
RewriteRule "(^|/)\.(?!well-known(?:/|$))" - [F,L]
<FilesMatch "(?i)(?:^(?:hugo\.toml|netlify\.toml|package(?:-lock)?\.json|composer\.(?:json|lock))$|\.(?:bak|orig|sql|sqlite3?|toml|ya?ml|md)$)">
    Require all denied
</FilesMatch>

# Redirect destinations stay local in localhost/staging previews. Production
# aliases go directly to the final HTTPS/apex URL, including www legacy URLs.
RewriteRule ^ - [E=DRCIL_REDIRECT_ORIGIN:]
RewriteCond %{HTTP_HOST} ^(?:www\.)?docdrhabibcil\.com(?::[0-9]+)?$ [NC]
RewriteRule ^ - [E=DRCIL_REDIRECT_ORIGIN:https://docdrhabibcil.com]

# Exact retired routes from static/_redirects precede the generic /tr/ rule.
RewriteRule ^(?:tr/)?page/[1-4]/?$ %{ENV:DRCIL_REDIRECT_ORIGIN}/ [R=301,L]
RewriteRule ^(en|ar)/page/[1-4]/?$ %{ENV:DRCIL_REDIRECT_ORIGIN}/$1/ [R=301,L]
RewriteRule ^hizmetler/sitemap\.xml$ %{ENV:DRCIL_REDIRECT_ORIGIN}/sitemap.xml [R=301,L]

# THE_REQUEST keeps the original encoded path. REQUEST_URI and RewriteRule
# backreferences are already decoded; blindly adding NE to those is unsafe.
# No QSD/new query: the original query string is preserved by Apache.
RewriteRule ^tr/?$ %{ENV:DRCIL_REDIRECT_ORIGIN}/ [R=301,L]
RewriteCond %{THE_REQUEST} "\s/+tr/+([^?\s]*)"
RewriteRule ^tr/ %{ENV:DRCIL_REDIRECT_ORIGIN}/%1 [R=301,L,NE]

# Canonical www host; localhost and other explicit preview hosts are untouched.
RewriteCond %{HTTP_HOST} ^www\.docdrhabibcil\.com(?::[0-9]+)?$ [NC]
RewriteCond %{THE_REQUEST} "\s/+([^?\s]*)"
RewriteRule ^ https://docdrhabibcil.com/%1 [R=301,L,NE]

# Direct-TLS-only optional block. Enable ONLY if the host confirms Apache itself
# terminates TLS. With a TLS proxy/CDN, enforce HTTPS there or configure trusted
# proxy mapping in the server configuration instead. Never copy this blindly.
# RewriteCond %{HTTP_HOST} ^docdrhabibcil\.com$ [NC]
# RewriteCond %{HTTPS} !=on
# RewriteCond %{THE_REQUEST} "\s/+([^?\s]*)"
# RewriteRule ^ https://docdrhabibcil.com/%1 [R=301,L,NE]

# Existing files/directories are served normally. Missing paths use ErrorDocument.
# Do not rewrite all requests to index.php, index.html, or a 404 page with 200.

<IfModule mod_mime.c>
    AddType text/css .css
    AddType text/javascript .js .mjs
    AddType application/json .json
    AddType application/xml .xml
    AddType image/svg+xml .svg
    AddType image/webp .webp
    AddType image/avif .avif
    AddType font/woff2 .woff2
    AddType model/gltf-binary .glb
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Cache-Control "no-store" "expr=%{REQUEST_STATUS} >= 400"

    # Content/search/sitemap changes must be revalidated, including / directory URLs.
    <FilesMatch "(?i)\.(?:html?|json|xml|txt)$">
        Header always set Cache-Control "public, max-age=0, must-revalidate" "expr=%{REQUEST_STATUS} == 200 || %{REQUEST_STATUS} == 304"
    </FilesMatch>
    # Mutable assets can change at the same URL; never mark them immutable.
    <FilesMatch "(?i)\.(?:css|js|mjs|svg|webp|avif|png|jpe?g|gif|ico|woff2?|ttf|otf|glb)$">
        Header always set Cache-Control "public, max-age=86400, must-revalidate" "expr=%{REQUEST_STATUS} == 200 || %{REQUEST_STATUS} == 304"
    </FilesMatch>
    # Hugo content-hashed CSS/JS only. Missing hashed URLs remain uncached errors.
    <FilesMatch "(?i)\.[0-9a-f]{32,128}\.(?:css|js)$">
        Header always set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_STATUS} == 200 || %{REQUEST_STATUS} == 304"
    </FilesMatch>
</IfModule>

<IfModule mod_filter.c>
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml
    </IfModule>
</IfModule>

# Host gates: valid TLS certificate/HTTPS enforcement; permitted overrides and
# modules; actual 301/404/MIME/cache/compression checks. No blanket PHP denial,
# untested CSP/COEP, or HSTS includeSubDomains/preload is imposed by this file.
